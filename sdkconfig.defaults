# ESP32-S3 + A7672S PPP + HTTPS Delta OTA
CONFIG_IDF_TARGET="esp32s3"
# Board reports 16 MB flash; use 16MB if your module matches (see boot log warning)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# lwIP PPP (required for UART/PPP via esp_modem)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_MPPE_SUPPORT=n
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

CONFIG_UART_ISR_IN_IRAM=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=n
# CGDCONT? is multi-line; 128 truncates. 512 is enough and stack-safe on main.
CONFIG_ESP_MODEM_C_API_STR_MAX=512
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# HTTPS client over PPP
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# Wi-Fi softAP
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Allow plain HTTP OTA (for local testing)
CONFIG_OTA_ALLOW_HTTP=y
